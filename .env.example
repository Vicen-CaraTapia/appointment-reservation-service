# Reference template only: Spring Boot does not load .env automatically.
# Supply values through your shell, IDE or container environment.
SERVER_PORT=8082

# Required at application startup. Never put credentials inside the URL.
APPOINTMENT_DB_URL=jdbc:postgresql://<host>:<port>/appointment_db
APPOINTMENT_DB_USERNAME=<appointment-application-user>
APPOINTMENT_DB_PASSWORD=<set-locally>

# Optional: only needed for the postgres-integration Maven profile.
# Use a disposable Appointment database; never Catalog or production.
# APPOINTMENT_TEST_DB_URL=jdbc:postgresql://<host>:<port>/appointment_test
# APPOINTMENT_TEST_DB_USERNAME=<appointment-test-user>
# APPOINTMENT_TEST_DB_PASSWORD=<set-locally>
