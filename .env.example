# Reference template only: Spring Boot does not load .env automatically.
# Supply values through your shell, IDE or container environment.
SERVER_PORT=8082

# Optional, comma-separated exact browser origins; leave empty for native clients only.
# Example: APPOINTMENT_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.test
APPOINTMENT_CORS_ALLOWED_ORIGINS=

# Required at application startup. Never put credentials inside the URL.
APPOINTMENT_DB_URL=jdbc:postgresql://<host>:<port>/appointment_db
APPOINTMENT_DB_USERNAME=<appointment-application-user>
APPOINTMENT_DB_PASSWORD=<set-locally>

# Required: Base64 encoding of at least 64 cryptographically random bytes.
# Dedicated final-user key; never reuse Catalog/internal or catedra credentials.
APPOINTMENT_USER_JWT_SECRET=<set-locally-base64-random-key>
APPOINTMENT_USER_JWT_TTL=1h
APPOINTMENT_USER_JWT_REMEMBER_ME_TTL=7d

# Required Catalog integration configuration; independent from both JWTs above/below.
CATALOG_BASE_URL=https://catalog.example.test
CATALOG_CONNECT_TIMEOUT=5s
CATALOG_READ_TIMEOUT=30s
# Absolute external file URI. The file is loaded and validated at startup.
# Unencrypted RSA PEM PKCS#8 (BEGIN PRIVATE KEY), at least 2048 bits.
# Keep it outside the repository; its matching public key is configured in Catalog.
INTERNAL_CATALOG_JWT_PRIVATE_KEY_LOCATION=file:/absolute/path/appointment-private.pem
INTERNAL_CATALOG_JWT_ISSUER=appointment-reservation-service
INTERNAL_CATALOG_JWT_AUDIENCE=catalog-sync-service
# Optional positive whole-second duration; default 5m. No static internal token.
INTERNAL_CATALOG_JWT_TTL=5m

# Required at application startup. These identify the technical cátedra integration,
# not an Appointment final user. The technical JWT is shared by both backend services.
CATEDRA_GROUP_ID=<catedra-assigned-integration-id>
CATEDRA_TECHNICAL_JWT=<set-locally-from-catedra>
CATEDRA_REST_BASE_URL=<catedra-rest-base-url>
# Required positive durations; examples only, tune for your environment.
CATEDRA_REST_CONNECT_TIMEOUT=5s
CATEDRA_REST_READ_TIMEOUT=30s
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=<catedra-kafka-bootstrap-servers>
CATEDRA_KAFKA_CONSUMER_GROUP_ID=<catedra-assigned-consumer-group-id>

# Use the exact topic names returned by the cátedra integration response.
# Do not derive or construct these names from CATEDRA_GROUP_ID.
CATEDRA_KAFKA_APPOINTMENT_ACTIONS_TOPIC=<catedra-appointment-actions-topic>
CATEDRA_KAFKA_APPOINTMENT_PHONE_TOPIC=<catedra-appointment-phone-topic>

# Optional: only needed for the postgres-integration Maven profile.
# Use a disposable Appointment database; never Catalog or production.
# APPOINTMENT_TEST_DB_URL=jdbc:postgresql://<host>:<port>/appointment_test
# APPOINTMENT_TEST_DB_USERNAME=<appointment-test-user>
# APPOINTMENT_TEST_DB_PASSWORD=<set-locally>

# Optional: only needed for the read-only catalog-integration Maven profile.
# Supply one existing enabled ID and one confirmed missing ID from the target Catalog instance.
# APPOINTMENT_TEST_CATALOG_PROFESSIONAL_ID=<existing-professional-id>
# APPOINTMENT_TEST_CATALOG_MISSING_PROFESSIONAL_ID=<confirmed-missing-professional-id>
